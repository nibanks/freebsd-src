/*-
 * SPDX-License-Identifier: BSD-2-Clause
 *
 * Copyright (c) 2026 Netflix, Inc.
 *
 * Schema for the "process" eventlog provider.
 *
 * Carries process and thread lifecycle metadata so consumers can
 * resolve a tid observed in a CPU/memory/etc. sample back to a
 * process and a (process, address) pair back to a user-mode binary.
 *
 * The provider exposes one global session. Live emission paths:
 *   - THREAD_CREATE  fork_exit() in kern_fork.c (new threads too)
 *   - THREAD_EXIT    thread_exit() in kern_thread.c
 *   - PROC_EXEC      do_execve() in kern_exec.c, after image switch
 *   - PROC_EXIT      exit1() in kern_exit.c
 *   - PROC_MAP       do_execve() (executable + interpreter) and
 *                    vn_mmap() (subsequent mmap(PROT_EXEC))
 *   - PROC_FORK      process_fork (child pid, parent pid); consumers
 *                    copy the parent's PROC_MAP set onto the child
 *   - PROC_TITLE     kern.proc.args write (setproctitle / $0) and the
 *                    capture-start dump when p_args is set
 *
 * Cross-provider contract: PROC_MAP.user_file_id is allocated by
 * eventlog_symbols_intern_user_file() (see <sys/eventlog_symbols.h>);
 * the USER_FILE event with that id is emitted on the *symbols*
 * provider. user_file_id == 0 means the mapping has no file backing
 * (anonymous, vp == NULL); consumers treat unresolvable PCs in such
 * regions as opaque.
 */

PROVIDER process

KEYWORD THREAD_META 1
KEYWORD PROC_META   2
KEYWORD MAP_META    4

STRUCT THREAD_CREATE
    tid:uint32_t
    pid:uint32_t
    comm:char[32]
    tdname:char[32]
STRUCT THREAD_EXIT
    tid:uint32_t
STRUCT PROC_EXEC
    pid:uint32_t
    ppid:uint32_t
    start_sec:uint64_t
    comm:char[32]
STRUCT PROC_EXIT
    pid:uint32_t
STRUCT PROC_MAP
    pid:uint32_t
    user_file_id:uint32_t
    base:uint64_t:hex
    size:uint64_t:hex
    offset:uint64_t:hex
STRUCT PROC_FORK
    pid:uint32_t
    ppid:uint32_t
STRUCT PROC_TITLE
    pid:uint32_t
    title:char[32]

EVENT THREAD_CREATE   0  INFO  THREAD_META  THREAD_CREATE
    "thread tid=%1 pid=%2 comm=%3 name=%4"
EVENT THREAD_EXIT     1  INFO  THREAD_META  THREAD_EXIT
    "thread exit tid=%1"
EVENT PROC_EXEC       2  INFO  PROC_META    PROC_EXEC
    "proc_exec pid=%1 ppid=%2 start_sec=%3 comm=%4"
EVENT PROC_EXIT       3  INFO  PROC_META    PROC_EXIT
    "proc_exit pid=%1"
EVENT PROC_MAP        4  INFO  MAP_META     PROC_MAP
    "proc_map pid=%1 file=%2 base=%3 size=%4 offset=%5"
EVENT PROC_FORK       5  INFO  PROC_META    PROC_FORK
    "proc_fork pid=%1 ppid=%2"
EVENT PROC_TITLE      6  INFO  PROC_META    PROC_TITLE
    "proc_title pid=%1 title=%2"
