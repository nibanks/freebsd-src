.Fa "enum eventlog_level level"
.Fa "uint32_t keywords"
.Fa "const struct iovec *iov"
.Fa "int iovcnt"
.Fc
.Ft void
.Fo eventlog_event_write_gather_at
.Fa "struct eventlog_session *session"
.Fa "uint32_t id"
.Fa "enum eventlog_level level"
.Fa "uint32_t keywords"
.Fa "const struct iovec *iov"
.Fa "int iovcnt"
.Fa "uint64_t timestamp_us"
.Fc
