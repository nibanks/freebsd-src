.Dd August 31, 2026
.Dt EVENTLOG_USER 3
.Os
.Sh NAME
.Nm eventlog_provider_create ,
.Nm eventlog_session_create ,
.Nm eventlog_session_set_enabled ,
.Nm eventlog_session_set_filter ,
.Nm eventlog_session_destroy ,
.Nm eventlog_provider_destroy ,
.Nm eventlog_provider_poll ,
.Nm eventlog_event_write ,
.Nm eventlog_event_write_at ,
.Nm eventlog_event_write_gather ,
.Nm eventlog_event_write_gather_at ,
.Nm eventlog_user_per_thread_rings_supported
.Nd user-space eventlog producer library
.Sh LIBRARY
.Lb libeventlog
.Sh SYNOPSIS
.In sys/eventlog.h
.Ft "struct eventlog_provider *"
.Fo eventlog_provider_create
.Fa "const char *name"
.Fa "const struct eventlog_provider_config *config"
.Fc
.Ft "struct eventlog_session *"
.Fo eventlog_session_create
.Fa "struct eventlog_provider *provider"
.Fa "uint64_t session_id"
.Fa "bool waitok"
.Fa "void *create_payload"
.Fa "size_t create_payload_size"
.Fc
.Ft void
.Fo eventlog_session_set_enabled
.Fa "struct eventlog_session *session"
.Fa "int enabled"
.Fc
.Ft void
.Fo eventlog_session_set_filter
.Fa "struct eventlog_session *session"
.Fa "enum eventlog_level level"
.Fa "uint32_t keywords"
.Fc
.Ft void
.Fo eventlog_session_destroy
.Fa "struct eventlog_session *session"
.Fc
.Ft void
.Fo eventlog_provider_destroy
.Fa "struct eventlog_provider *provider"
.Fc
.Ft int
.Fo eventlog_provider_poll
.Fa "struct eventlog_provider *provider"
.Fc
.Ft void
.Fo eventlog_event_write
.Fa "struct eventlog_session *session"
.Fa "uint32_t id"
.Fa "enum eventlog_level level"
.Fa "uint32_t keywords"
.Fa "void *buffer"
.Fa "size_t length"
.Fc
.Ft void
.Fo eventlog_event_write_at
.Fa "struct eventlog_session *session"
.Fa "uint32_t id"
.Fa "enum eventlog_level level"
.Fa "uint32_t keywords"
.Fa "void *buffer"
.Fa "size_t length"
.Fa "uint64_t timestamp_us"
.Fc
.Ft void
.Fo eventlog_event_write_gather
