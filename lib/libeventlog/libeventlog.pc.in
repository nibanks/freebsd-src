prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
datadir=${prefix}/share
eventlog_gen=${datadir}/eventlog/eventlog_gen.awk

Name: libeventlog
Description: user-space eventlog producer library
Version: @VERSION@
Libs: -L${libdir} -leventlog
Libs.private: -lpthread
Cflags: -I${includedir}
